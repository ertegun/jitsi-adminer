# Database
# SQLite for development (default)
DATABASE_URL="file:./dev.db"
# MySQL for production (uncomment and configure)
# DATABASE_URL="mysql://user:password@localhost:3306/jitsi_admin"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here-generate-with-openssl-rand-base64-32"

# Jitsi Server Connection Mode
# remote = panel connects to external Jitsi server (default, SaaS mode)
# embedded = panel + Jitsi run together (on-prem mode, requires docker-compose.jitsi.yml)
JITSI_DEPLOYMENT_MODE="remote"

# Jitsi Webhook Secret (for securing /api/webhooks/jitsi endpoint)
JITSI_WEBHOOK_SECRET="your-webhook-secret-here-generate-with-openssl-rand-base64-32"

# SMTP Settings (for email invitations)
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="your-smtp-username"
SMTP_PASSWORD="your-smtp-password"
SMTP_FROM="noreply@yourcompany.com"

# Jibri Recording (optional, for recording feature)
JIBRI_ENABLED="false"
JIBRI_API_URL="http://jibri:8080"
JIBRI_STORAGE_PATH="/recordings"

# Docker Network (only for embedded mode)
JITSI_DOCKER_NETWORK="jitsi-meet"
